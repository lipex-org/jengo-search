{
  "name": "jengo/search",
  "description": "Enterprise-grade, multi-driver full-text and semantic search engine subsystem for CodeIgniter 4 and the Jengo Framework.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Ian Ochieng",
      "email": "ochiengian383@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.7",
    "jengo/base": "^1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Jengo\\Search\\": "src/"
    },
    "files": [
      "src/Helpers/search_helper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Tests\\Support\\": "tests/_support/"
    }
  },
  "extra": {
    "codeigniter4": {
      "registrar": [
        "Jengo\\Search\\Config\\Registrar"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit --no-coverage --colors=always"
  }
}
